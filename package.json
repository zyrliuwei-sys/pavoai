{
  "name": "pavoai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "prebuild": "node scripts/db-setup.mjs",
    "build": "DATABASE_PROVIDER=sqlite vite build",
    "start": "node .output/server/index.mjs",
    "precf:build": "node scripts/db-setup.mjs",
    "cf:build": "DATABASE_PROVIDER=sqlite NITRO_PRESET=cloudflare_module vite build",
    "cf:deploy": "sh -c 'set -a && [ -f .env.production ] && . ./.env.production; set +a && pnpm cf:build && exec wrangler deploy'",
    "postinstall": "mkdir -p data && (test -f src/config/db/schema.ts || node scripts/db-setup.mjs)",
    "db:setup": "node scripts/db-setup.mjs",
    "db:push": "tsx scripts/with-env.ts drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "tsx scripts/with-env.ts drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/with-env.ts drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "tsx scripts/with-env.ts drizzle-kit studio --config=drizzle.config.ts",
    "rbac:init": "tsx scripts/with-env.ts tsx scripts/init-rbac.ts",
    "rbac:assign": "tsx scripts/with-env.ts tsx scripts/assign-role.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "admin:token": "tsx scripts/with-env.ts tsx scripts/admin-token.ts",
    "admin:mcp": "tsx scripts/admin-mcp.ts",
    "test:admin": "node --import tsx --test tests/admin-agent.test.ts",
    "test:indexnow": "node --import tsx --test tests/indexnow.test.ts",
    "test:guest-posts": "node --import tsx --test tests/guest-posts.test.ts tests/guest-post-notify.test.ts",
    "test:payment": "node --import tsx --test tests/payment-idempotency.test.ts tests/payment-guards.test.ts tests/refund.test.ts",
    "test:atomic": "node --import tsx --test tests/atomic.test.ts",
    "test:atomic:d1": "ATOMIC_D1=1 node --import tsx --test tests/atomic.test.ts",
    "test:d1-http": "node --import tsx --test tests/d1-http.test.ts",
    "test:atomic:pg": "TSX_TSCONFIG_PATH=tests/tsconfig.pg.json node --import tsx --test tests/atomic.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write",
    "*.{json,css,md,mdx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@libsql/client": "^0.14.0",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/mdx": "^2.0.14",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.511.0",
    "markdown-it": "^14.3.3",
    "motion": "^12.43.0",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "replicate": "^1.4.0",
    "resend": "^4.8.0",
    "shadcn": "^4.23.0",
    "simple-flakeid": "^0.0.5",
    "sonner": "^2.0.8",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inlang/paraglide-js": "^2.29.2",
    "@inlang/plugin-message-format": "4.5.6",
    "@mdx-js/rollup": "^3.1.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msw",
      "sharp"
    ],
    "overrides": {
      "seroval": "1.6.8",
      "seroval-plugins": "1.6.8",
      "next": "-"
    }
  }
}
